# Ключ кабинета ОРД (ваш договор с оператором). Сейчас описан обмен ОРД VK.
# MCP_ERID_ORD_TOKEN=
# MCP_ERID_ORD_PROVIDER=vk
# MCP_ERID_ORD_BASE_URL=https://api.ord.vk.com

# Наше размещение — отдельная услуга, не ключ ОРД.
# MCP_ERID_API_KEY=

# Необязательно:
# MCP_ERID_API_BASE=https://api.atomno-mcp.ru/erid
# MCP_ERID_TIMEOUT=30
# MCP_ERID_LOG_LEVEL=INFO
